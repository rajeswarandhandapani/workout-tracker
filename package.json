{
  "name": "workout-tracker",
  "version": "2.0.0",
  "private": true,
  "description": "Private daily workout log for a 12-week heart-health plan. Built with Angular, Tailwind CSS, DaisyUI, and IndexedDB.",
  "packageManager": "npm@11.16.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4183",
    "build": "ng build --configuration production --base-href ./",
    "build:pages": "ng build --configuration production --base-href /workout-tracker/",
    "watch": "ng build --watch --configuration development",
    "test": "node --import ./tests/ts-resolve.mjs --test tests/*.test.mjs",
    "test:browser": "node tests/browser.cjs",
    "icons": "node scripts/make-icons.cjs"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/service-worker": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@tailwindcss/postcss": "latest",
    "daisyui": "latest",
    "playwright": "1.63.0",
    "postcss": "latest",
    "prettier": "^3.8.1",
    "tailwindcss": "latest",
    "typescript": "~6.0.2"
  }
}
